{
  "$schema": "./node_modules/@angular-devkit/schematics/collection-schema.json",
  "schematics": {
    "application": {
      "factory": "./lib/application/application.factory#main",
      "description": "Create a Nest application.",
      "schema": "./lib/application/schema.json"
    },
    "schematic": {
      "factory": "./lib/schematic/schematic.factory#main",
      "description": "Create a Nest schematic.",
      "schema": "./lib/schematic/schema.json"
    },
    "resource": {
      "factory": "./lib/resource/resource.factory#main",
      "description": "Create a Nest resource.",
      "schema": "./lib/resource/schema.json",
      "aliases": ["res"]
    },
    "user": {
      "factory": "./lib/user/user.factory#main",
      "description": "Create a Nest user resource (REST + MongoDB/Mongoose).",
      "schema": "./lib/user/schema.json",
      "aliases": ["u"]
    },
    "auth": {
      "factory": "./lib/auth/auth.factory#main",
      "description": "Create a Nest auth module (JWT password or email/SMS login code) wired to the user resource.",
      "schema": "./lib/auth/schema.json"
    }
  }
}
